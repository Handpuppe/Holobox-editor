{
  "name": "holobox-zorgsimulator",
  "version": "0.2.4",
  "private": true,
  "type": "module",
  "description": "Holobox Zorgsimulator – Logopedie en Verpleegkunde",
  "engines": {
    "node": "24.20.0",
    "npm": "11.19.0"
  },
  "packageManager": "npm@11.19.0",
  "scripts": {
    "media:manifest": "node scripts/generate-media-manifest.mjs",
    "dev": "npm run media:manifest && vite",
    "build": "npm run media:manifest && tsc -b && vite build",
    "preview": "vite preview --host 127.0.0.1 --port 4173 --strictPort",
    "preview:editor": "vite preview --host 127.0.0.1 --port 4174 --strictPort",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint .",
    "typecheck": "tsc -b --pretty false",
    "test": "vitest run",
    "test:unit": "vitest run",
    "test:e2e": "npm run build && playwright test",
    "test:a11y": "npm run build && playwright test --grep @a11y",
    "test:visual": "npm run build && playwright test --grep @visual",
    "verify": "npm run format:check && npm run lint && npm run typecheck && npm run test:unit && npm run build"
  },
  "dependencies": {
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-router-dom": "7.18.3"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.13.0",
    "@eslint/js": "9.39.5",
    "@playwright/test": "1.63.0",
    "@testing-library/jest-dom": "6.9.1",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.7",
    "@types/node": "24.13.4",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "5.1.4",
    "axe-core": "4.13.0",
    "eslint": "9.39.5",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-jsx-a11y": "6.10.2",
    "eslint-plugin-react-hooks": "7.1.1",
    "globals": "17.12.0",
    "jsdom": "30.0.1",
    "prettier": "3.9.6",
    "typescript": "5.9.3",
    "typescript-eslint": "8.70.0",
    "vite": "7.3.6",
    "vitest": "4.1.11"
  }
}
